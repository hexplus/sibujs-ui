{
  "name": "sibujs-ui",
  "version": "1.6.0",
  "description": "UI components for SibuJS — Tailwind-styled, signal-driven, zero VDOM.",
  "keywords": [
    "sibujs",
    "ui",
    "components",
    "tailwind",
    "shadcn"
  ],
  "homepage": "https://github.com/hexplus/sibujs-ui#readme",
  "bugs": {
    "url": "https://github.com/hexplus/sibujs-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexplus/sibujs-ui.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.3.0"
  },
  "author": "hexplus (https://github.com/hexplus)",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sibujs-ui": "bin/sibujs-ui.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src/themes",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cdn": {
      "default": "./dist/cdn.global.js"
    },
    "./cdn-dev": {
      "default": "./dist/cdn.dev.global.js"
    },
    "./cdn-css": {
      "default": "./dist/sibujs-ui.css"
    },
    "./themes/*": "./src/themes/*",
    "./registry/*": "./dist/registry/*"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --out-dir dist && npm run build:cdn && npm run build:css && npm run build:registry",
    "build:cdn": "tsup --config tsup.cdn.config.ts",
    "build:css": "tailwindcss -i styles/cdn.css -o dist/sibujs-ui.css --minify",
    "build:registry": "node scripts/registry/build.mjs",
    "registry:verify": "node scripts/registry/verify.mjs",
    "lint": "biome check --max-diagnostics=500 src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "sibujs": ">=3.2.0 <5.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.7",
    "jsdom": "^25.0.0",
    "lucide": "^1.7.0",
    "sibujs": "^4.4.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
